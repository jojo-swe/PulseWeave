# =============================================================================
# PulseWeave Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env before running docker compose up
#
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# REQUIRED — JWT signing secret (64+ characters)
JWT_SECRET=

# REQUIRED — Cookie signing secret (32+ characters)
COOKIE_SECRET=

# Frontend public URL (used for CORS, emails, redirects)
FRONTEND_URL=http://localhost:9797

# Allowed CORS origins (comma-separated if multiple)
CORS_ORIGINS=http://localhost:9797

# Backend API URL the frontend calls (set to your public domain in production)
NEXT_PUBLIC_API_URL=http://localhost:9090

# WebSocket URL (derived from API URL by default; only override if different)
# NEXT_PUBLIC_WS_URL=ws://localhost:9090
