# =============================================================================
# PulseWeave Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=9090
NODE_ENV=development
FRONTEND_URL=http://localhost:9797

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# IMPORTANT: Change this to a secure random string in production (min 32 chars)
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# JWT token expiration times
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite (default - works great for small teams up to ~100 users)
DATABASE_URL="file:./dev.db"

# PostgreSQL (recommended for scaling 100+ users)
# DATABASE_URL="postgresql://user:password@localhost:5432/pulseweave?schema=public"
#
# To switch to PostgreSQL:
#   1. Update packages/database/prisma/schema.prisma: provider = "postgresql"
#   2. Set DATABASE_URL above to your PostgreSQL connection string
#   3. Run: pnpm db:generate && pnpm db:push

# -----------------------------------------------------------------------------
# SSL/TLS Configuration
# -----------------------------------------------------------------------------
# Enable SSL/TLS
SSL_ENABLED=false

# Paths to SSL certificates
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt
SSL_CA_PATH=./certs/ca.crt

# SSL Port (default 3443)
SSL_PORT=3443

# Redirect HTTP to HTTPS
SSL_HTTP_REDIRECT=true

# Minimum TLS version (TLSv1.2 or TLSv1.3)
SSL_MIN_VERSION=TLSv1.2

# -----------------------------------------------------------------------------
# Cookie Security
# -----------------------------------------------------------------------------
# Secret for signing cookies (change in production!)
COOKIE_SECRET=change-this-cookie-secret-in-production

# -----------------------------------------------------------------------------
# Security - Account Lockout
# -----------------------------------------------------------------------------
# Maximum failed login attempts before account lockout
ACCOUNT_MAX_FAILED_ATTEMPTS=5

# Account lockout duration in minutes
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# Progressive lockout multiplier (each lockout increases by this factor)
LOCKOUT_PROGRESSIVE_MULTIPLIER=2

# -----------------------------------------------------------------------------
# Security - IP Blocking
# -----------------------------------------------------------------------------
# Maximum failed attempts from an IP before blocking
MAX_FAILED_ATTEMPTS=10

# IP block duration in minutes
IP_BLOCK_DURATION_MINUTES=30

# Time window for counting failed attempts (minutes)
ATTEMPT_WINDOW_MINUTES=15

# -----------------------------------------------------------------------------
# Security - Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# -----------------------------------------------------------------------------
# LDAP Configuration (Optional)
# -----------------------------------------------------------------------------
# Enable LDAP authentication
LDAP_ENABLED=false

# LDAP Server URL (ldap:// or ldaps:// for TLS)
LDAP_URL=ldap://localhost:389

# Service account for searching users
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-bind-password

# Base DN for user searches
LDAP_SEARCH_BASE=dc=example,dc=com

# Filter to find users ({{username}} will be replaced with the login username)
LDAP_SEARCH_FILTER=(uid={{username}})

# Attribute mappings
LDAP_USERNAME_ATTR=uid
LDAP_EMAIL_ATTR=mail
LDAP_DISPLAY_NAME_ATTR=cn

# Group configuration (optional)
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com
LDAP_GROUP_SEARCH_FILTER=(member={{dn}})
LDAP_ADMIN_GROUP=cn=admins,ou=groups,dc=example,dc=com

# TLS Configuration
LDAP_TLS_REJECT_UNAUTHORIZED=true

# -----------------------------------------------------------------------------
# WebAuthn Configuration (for MFA)
# -----------------------------------------------------------------------------
# Relying Party ID (usually your domain without protocol)
WEBAUTHN_RP_ID=localhost

# Origin for WebAuthn (your frontend URL)
WEBAUTHN_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Session Management
# -----------------------------------------------------------------------------
# Use database-backed sessions (recommended for production)
USE_DB_SESSIONS=false

# Session expiry in hours
SESSION_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
# SMTP server settings (leave empty for development console logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email sender details
EMAIL_FROM=noreply@pulseweave.com
EMAIL_FROM_NAME=PulseWeave

# -----------------------------------------------------------------------------
# Logging & Error Reporting
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# Sentry DSN for error reporting (optional, leave empty to disable)
# Get your DSN from https://sentry.io
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Stripe Configuration (Payments)
# -----------------------------------------------------------------------------
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Webhook secret for verifying Stripe webhook signatures
# Get this from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# 
# REQUIRED FOR ALL DEPLOYMENTS:
# 1. [ ] JWT_SECRET is a secure random string (64+ chars)
#        Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 2. [ ] COOKIE_SECRET is a secure random string (32+ chars)
# 3. [ ] SSL_ENABLED=true with valid certificates
# 4. [ ] NODE_ENV=production
# 5. [ ] CORS_ORIGINS is set to your actual domain
# 6. [ ] Rate limiting values are appropriate for your traffic
# 7. [ ] All default passwords are changed
# 8. [ ] Backups are configured
#
# DATABASE (choose based on your scale):
# - SQLite (< 100 users): Store DB file outside web root, chmod 600
# - PostgreSQL (100+ users): Use strong passwords, enable SSL
#
# FOR SCALING (100+ users or multiple instances):
# 9. [ ] Switch to PostgreSQL (SQLite doesn't scale horizontally)
# 10. [ ] USE_DB_SESSIONS=true for clustered deployments
# 11. [ ] Configure Redis adapter for Socket.io (if multiple instances)
# 12. [ ] Monitoring/alerting is configured (SENTRY_DSN, etc.)
#
# See PRODUCTION.md for detailed deployment guide.
# =============================================================================
