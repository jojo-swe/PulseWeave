# =============================================================================
# PulseWeave Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# IMPORTANT: Change this to a secure random string in production (min 32 chars)
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# JWT token expiration times
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# SSL/TLS Configuration
# -----------------------------------------------------------------------------
# Enable SSL/TLS
SSL_ENABLED=false

# Paths to SSL certificates
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt
SSL_CA_PATH=./certs/ca.crt

# SSL Port (default 3443)
SSL_PORT=3443

# Redirect HTTP to HTTPS
SSL_HTTP_REDIRECT=true

# Minimum TLS version (TLSv1.2 or TLSv1.3)
SSL_MIN_VERSION=TLSv1.2

# -----------------------------------------------------------------------------
# Cookie Security
# -----------------------------------------------------------------------------
# Secret for signing cookies (change in production!)
COOKIE_SECRET=change-this-cookie-secret-in-production

# -----------------------------------------------------------------------------
# Security - Account Lockout
# -----------------------------------------------------------------------------
# Maximum failed login attempts before account lockout
ACCOUNT_MAX_FAILED_ATTEMPTS=5

# Account lockout duration in minutes
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# Progressive lockout multiplier (each lockout increases by this factor)
LOCKOUT_PROGRESSIVE_MULTIPLIER=2

# -----------------------------------------------------------------------------
# Security - IP Blocking
# -----------------------------------------------------------------------------
# Maximum failed attempts from an IP before blocking
MAX_FAILED_ATTEMPTS=10

# IP block duration in minutes
IP_BLOCK_DURATION_MINUTES=30

# Time window for counting failed attempts (minutes)
ATTEMPT_WINDOW_MINUTES=15

# -----------------------------------------------------------------------------
# Security - Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# -----------------------------------------------------------------------------
# LDAP Configuration (Optional)
# -----------------------------------------------------------------------------
# Enable LDAP authentication
LDAP_ENABLED=false

# LDAP Server URL (ldap:// or ldaps:// for TLS)
LDAP_URL=ldap://localhost:389

# Service account for searching users
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-bind-password

# Base DN for user searches
LDAP_SEARCH_BASE=dc=example,dc=com

# Filter to find users ({{username}} will be replaced with the login username)
LDAP_SEARCH_FILTER=(uid={{username}})

# Attribute mappings
LDAP_USERNAME_ATTR=uid
LDAP_EMAIL_ATTR=mail
LDAP_DISPLAY_NAME_ATTR=cn

# Group configuration (optional)
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com
LDAP_GROUP_SEARCH_FILTER=(member={{dn}})
LDAP_ADMIN_GROUP=cn=admins,ou=groups,dc=example,dc=com

# TLS Configuration
LDAP_TLS_REJECT_UNAUTHORIZED=true

# -----------------------------------------------------------------------------
# WebAuthn Configuration (for MFA)
# -----------------------------------------------------------------------------
# Relying Party ID (usually your domain without protocol)
WEBAUTHN_RP_ID=localhost

# Origin for WebAuthn (your frontend URL)
WEBAUTHN_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Session Management
# -----------------------------------------------------------------------------
# Use database-backed sessions (recommended for production)
USE_DB_SESSIONS=false

# Session expiry in hours
SESSION_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# 
# 1. [ ] JWT_SECRET is a secure random string (64+ chars)
#        Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# 2. [ ] COOKIE_SECRET is a secure random string (32+ chars)
#
# 3. [ ] SSL_ENABLED=true with valid certificates
#
# 4. [ ] USE_DB_SESSIONS=true for clustered deployments
#
# 5. [ ] NODE_ENV=production
#
# 6. [ ] Database is PostgreSQL (not SQLite)
#
# 7. [ ] CORS_ORIGINS is set to your actual domain
#
# 8. [ ] Rate limiting values are appropriate for your traffic
#
# 9. [ ] All default passwords are changed
#
# 10. [ ] Monitoring/alerting is configured (SENTRY_DSN, etc.)
# =============================================================================
