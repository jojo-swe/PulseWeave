# =============================================================================
# PulseWeave Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values

# Backend API URL (required)
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket URL (required for real-time features)
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
# NEXT_PUBLIC_WS_URL=wss://api.your-domain.com

# Build output mode (standalone recommended for Docker)
# NEXT_OUTPUT_MODE=standalone

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================
# Enable analytics (if configured)
# NEXT_PUBLIC_ANALYTICS_ID=UA-XXXXXXXXX-X

# Sentry error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
