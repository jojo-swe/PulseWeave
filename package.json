{
  "name": "pulseweave",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "pnpm db:generate && pnpm --filter backend build && pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:desktop": "pnpm --filter desktop build",
    "build:desktop:win": "pnpm --filter desktop dist:win",
    "build:desktop:mac": "pnpm --filter desktop dist:mac",
    "build:desktop:linux": "pnpm --filter desktop dist:linux",
    "build:desktop:all": "pnpm --filter desktop dist:all",
    "build:mobile:ios": "pnpm --filter mobile build:ios",
    "build:mobile:android": "pnpm --filter mobile build:android",
    "start": "concurrently \"pnpm start:backend\" \"pnpm start:frontend\"",
    "start:backend": "pnpm --filter backend start",
    "start:frontend": "pnpm --filter frontend start",
    "db:generate": "pnpm --filter database generate",
    "db:push": "pnpm --filter database push",
    "db:migrate": "pnpm --filter database migrate",
    "db:studio": "pnpm --filter database studio",
    "lint": "pnpm --filter frontend lint",
    "typecheck": "pnpm --filter backend build && pnpm --filter frontend build",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "concurrently": "^9.2.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "pnpm": "^10.24.0"
  }
}
