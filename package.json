{
  "name": "pulseweave",
  "version": "1.0.0",
  "packageManager": "pnpm@10.26.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:desktop": "pnpm --filter pulseweave-desktop dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "pnpm db:generate && pnpm --filter types build && pnpm --filter database build && pnpm --filter backend build && pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:desktop": "pnpm --filter pulseweave-desktop build",
    "build:desktop:win": "pnpm --filter pulseweave-desktop dist:win",
    "build:desktop:mac": "pnpm --filter pulseweave-desktop dist:mac",
    "build:desktop:linux": "pnpm --filter pulseweave-desktop dist:linux",
    "build:desktop:all": "pnpm --filter pulseweave-desktop dist:all",
    "build:mobile:ios": "pnpm --filter mobile build:ios",
    "build:mobile:android": "pnpm --filter mobile build:android",
    "start": "concurrently \"pnpm start:backend\" \"pnpm start:frontend\"",
    "start:backend": "pnpm --filter backend start",
    "start:frontend": "pnpm --filter frontend start",
    "db:generate": "pnpm --filter database generate",
    "db:push": "pnpm --filter database push",
    "db:migrate": "pnpm --filter database migrate",
    "db:studio": "pnpm --filter database studio",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "lint:frontend": "pnpm --filter frontend lint",
    "lint:backend": "cd apps/backend && eslint src --ext .ts",
    "typecheck": "pnpm --filter backend build && pnpm --filter frontend build",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "stop:dev": "powershell -Command \"if ($env:NODE_ENV -eq 'production') { Write-Output 'Skip stop:dev in production'; exit 0 } Get-Process node -ErrorAction SilentlyContinue | Stop-Process -Force\""
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "concurrently": "^9.2.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7"
  },
  "pnpm": {
    "overrides": {
      "semver@^7.0.0": "7.7.3",
      "@react-native-community/cli-hermes": "12.3.7",
      "@react-native-community/cli-doctor": "12.3.7"
    },
    "onlyBuiltDependencies": [
      "electron",
      "sharp",
      "unrs-resolver"
    ]
  },
  "license": "AGPL-3.0"
}