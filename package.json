{
  "name": "pulseweave",
  "version": "1.0.0",
  "packageManager": "pnpm@10.26.2",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:desktop": "pnpm --filter pulseweave-desktop dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "pnpm db:generate && pnpm --filter types build && pnpm --filter database build && pnpm --filter backend build && pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:desktop": "pnpm --filter pulseweave-desktop build",
    "build:desktop:win": "pnpm --filter pulseweave-desktop dist:win",
    "build:desktop:mac": "pnpm --filter pulseweave-desktop dist:mac",
    "build:desktop:linux": "pnpm --filter pulseweave-desktop dist:linux",
    "build:desktop:all": "pnpm --filter pulseweave-desktop dist:all",
    "build:mobile:ios": "pnpm --filter mobile build:ios",
    "build:mobile:android": "pnpm --filter mobile build:android",
    "start": "concurrently \"pnpm start:backend\" \"pnpm start:frontend\"",
    "start:backend": "pnpm --filter backend start",
    "start:frontend": "pnpm --filter frontend start",
    "db:generate": "pnpm --filter database generate",
    "db:push": "pnpm --filter database push",
    "db:migrate": "pnpm --filter database migrate",
    "db:studio": "pnpm --filter database studio",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "lint:frontend": "pnpm --filter frontend lint",
    "lint:backend": "cd apps/backend && eslint src --ext .ts",
    "test": "pnpm test:backend",
    "test:backend": "pnpm --filter backend test",
    "typecheck": "pnpm --filter backend build && pnpm --filter frontend build",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "stop:dev": "powershell -Command \"if ($env:NODE_ENV -eq 'production') { Write-Output 'Skip stop:dev in production'; exit 0 } Get-Process node -ErrorAction SilentlyContinue | Stop-Process -Force\""
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "concurrently": "^9.2.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7"
  },
  "pnpm": {
    "overrides": {
      "semver@^7.0.0": "7.7.3",
      "@react-native-community/cli-hermes": "12.3.7",
      "@react-native-community/cli-doctor": "12.3.7",
      "tar": "7.5.21",
      "joi": "17.13.7",
      "engine.io": "6.6.10",
      "socket.io-parser": "4.2.7",
      "fast-xml-parser@<5": "4.5.5",
      "fast-xml-parser@>=5": "5.5.6",
      "@remix-run/node": "2.17.5",
      "@remix-run/server-runtime": "2.17.5",
      "@remix-run/router": "1.23.3",
      "turbo-stream": "3.0.0",
      "proxy-addr": "2.0.8",
      "shell-quote": "1.11.0",
      "tinypool": "2.1.2",
      "@babel/plugin-transform-modules-systemjs": "7.29.4",
      "@xmldom/xmldom": "0.8.15",
      "app-builder-lib": "26.15.0",
      "builder-util-runtime": "9.7.0",
      "electron-builder-squirrel-windows": "26.15.0",
      "brace-expansion@<2": "1.1.20",
      "brace-expansion@>=2 <3": "2.1.6",
      "browserslist": "4.28.7",
      "compression": "1.8.2",
      "fast-uri": "3.1.7",
      "flatted": "3.4.2",
      "form-data@<4": "3.0.5",
      "form-data@>=4": "4.0.6",
      "http-cache-semantics": "4.3.0",
      "image-size": "2.0.3",
      "ip-address": "10.3.1",
      "js-yaml@<4": "3.15.2",
      "js-yaml@>=4 <5": "4.3.2",
      "lodash": "4.18.0",
      "minimatch@<4": "3.1.4",
      "minimatch@>=5 <6": "5.1.8",
      "minimatch@>=9 <10": "9.0.7",
      "nanoid": "3.3.18",
      "node-forge": "1.4.0",
      "path-to-regexp": "8.4.0",
      "picomatch@<3": "2.3.2",
      "picomatch@>=3 <4": "3.0.2",
      "picomatch@>=4": "4.0.4",
      "postcss": "8.5.18",
      "rollup": "4.59.0",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "tmp": "0.2.7",
      "ws@>=6 <7": "6.2.4",
      "ws@>=7 <8": "7.5.11",
      "ws@>=8": "8.21.0"
    },
    "onlyBuiltDependencies": [
      "electron",
      "sharp",
      "unrs-resolver"
    ]
  },
  "license": "AGPL-3.0"
}