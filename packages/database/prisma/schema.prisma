generator client {
  provider = "prisma-client-js"
}

// Database Configuration
// -----------------------
// SQLite (default, for development and small deployments):
//   DATABASE_URL="file:./dev.db"
//
// PostgreSQL (recommended for production and scaling):
//   DATABASE_URL="postgresql://user:password@localhost:5432/pulseweave?schema=public"
//
// To switch databases:
//   1. Update DATABASE_URL in packages/database/.env
//   2. Change provider below to "postgresql" 
//   3. Run: pnpm db:generate && pnpm db:push

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  displayName   String
  passwordHash  String
  avatarUrl     String?
  status        String    @default("online")
  statusMessage String?
  
  // E2E Encryption keys
  publicKey     String?   // Base64 encoded ECDH public key for key exchange
  publicKeyId   String?   // Key identifier for key rotation
  keyUpdatedAt  DateTime? // When keys were last rotated
  
  // MFA fields
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?   // TOTP secret (encrypted)
  mfaBackupCodes String?  // JSON array of backup codes (hashed)
  
  // Account status
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  lastLoginAt   DateTime?
  lastLoginIp   String?
  failedLoginAttempts Int @default(0)
  lockedUntil   DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  ownedWorkspaces      Workspace[]         @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  channelMemberships   ChannelMember[]
  messages             Message[]
  reactions            Reaction[]
  createdChannels      Channel[]           @relation("ChannelCreator")
  conversations        ConversationMember[]
  directMessages       DirectMessage[]
  webauthnCredentials  WebAuthnCredential[]
  sessions             Session[]
  auditLogs            AuditLog[]
  apiKeys              ApiKey[]
  webhooks             Webhook[]
  incomingWebhooks     IncomingWebhook[]
  integrations         Integration[]
  uploads              Attachment[]        @relation("UserUploads")
  preferences          UserPreferences?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  friendRequestsSent   Friendship[]        @relation("FriendRequestsSent")
  friendRequestsReceived Friendship[]      @relation("FriendRequestsReceived")
  subscription         Subscription?
  pushSubscriptions    PushSubscription[]

  @@map("users")
}

// User preferences for notifications, appearance, and status
model UserPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  
  // Appearance
  theme                 String   @default("dark") // dark, light, corporate, midnight, system
  
  // Notification settings
  desktopNotifications  Boolean  @default(true)
  soundEnabled          Boolean  @default(true)
  notificationPreview   Boolean  @default(true)
  mentionNotifications  Boolean  @default(true)
  dmNotifications       Boolean  @default(true)
  channelNotifications  Boolean  @default(true)
  threadReplies         Boolean  @default(true)
  
  // Quiet hours
  quietHoursEnabled     Boolean  @default(false)
  quietHoursStart       String   @default("22:00")
  quietHoursEnd         String   @default("08:00")
  
  // Status timeouts (in minutes)
  idleTimeout           Int      @default(5)
  awayTimeout           Int      @default(15)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// WebAuthn/FIDO2 credentials (YubiKey, Passkeys, etc.)
model WebAuthnCredential {
  id              String   @id @default(cuid())
  userId          String
  credentialId    String   @unique // Base64 encoded credential ID
  publicKey       String   // Base64 encoded public key
  counter         Int      @default(0)
  deviceType      String   // "singleDevice" | "multiDevice"
  backedUp        Boolean  @default(false)
  transports      String?  // JSON array of transports
  name            String   // User-friendly name (e.g., "YubiKey 5")
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webauthn_credentials")
}

// User sessions for session management
model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenId      String   @unique // JWT jti for revocation
  deviceInfo   String?  // User agent / device info
  ipAddress    String?
  isValid      Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isValid])
  @@map("sessions")
}

// Email verification tokens
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// Audit log for security events
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // e.g., "LOGIN", "LOGOUT", "MFA_ENABLED", "ROLE_CHANGED"
  resource    String?  // e.g., "user", "workspace", "channel"
  resourceId  String?
  details     String?  // JSON details
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// Global roles (system-wide)
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "superadmin", "admin", "user"
  description String?
  isSystem    Boolean  @default(false) // System roles can't be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  permissions RolePermission[]
  members     WorkspaceMember[]

  @@map("roles")
}

// Permissions
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "workspace:create", "channel:delete"
  description String?
  category    String   // e.g., "workspace", "channel", "user", "message"
  createdAt   DateTime @default(now())

  // Relations
  roles RolePermission[]

  @@map("permissions")
}

// Role-Permission mapping
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  iconUrl   String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner            User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members          WorkspaceMember[]
  channels         Channel[]
  messages         Message[]
  reactions        Reaction[]
  attachments      Attachment[]
  categories       ChannelCategory[]
  conversations    Conversation[]
  directMessages   DirectMessage[]
  apiKeys          ApiKey[]
  webhooks         Webhook[]
  incomingWebhooks IncomingWebhook[]
  integrations     Integration[]
  auditLogs        AuditLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  roleId      String?  // Reference to Role model
  roleName    String   @default("member") // Fallback for legacy/simple roles
  joinedAt    DateTime @default(now())
  invitedBy   String?
  invitedAt   DateTime?

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, workspaceId])
  @@index([workspaceId]) // For listing workspace members
  @@index([userId])      // For listing user's workspaces
  @@map("workspace_members")
}

model ChannelCategory {
  id          String   @id @default(cuid())
  name        String
  workspaceId String
  position    Int      @default(0)
  isCollapsed Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels  Channel[]

  @@unique([workspaceId, name])
  @@map("channel_categories")
}

model Channel {
  id          String   @id @default(cuid())
  name        String
  description String?
  workspaceId String
  categoryId  String?
  isPrivate   Boolean  @default(false)
  isEncrypted Boolean  @default(false) // E2E encryption enabled for this channel
  position    Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category         ChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy        User             @relation("ChannelCreator", fields: [createdById], references: [id])
  members          ChannelMember[]
  messages         Message[]
  incomingWebhooks IncomingWebhook[]

  @@unique([workspaceId, name])
  @@map("channels")
}

model ChannelMember {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  joinedAt  DateTime @default(now())

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId]) // For listing channel members
  @@map("channel_members")
}

model Message {
  id          String   @id @default(cuid())
  content     String
  channelId   String
  workspaceId String   // Tenant Context
  userId      String
  parentId    String?
  isEdited    Boolean  @default(false)
  isPinned    Boolean  @default(false)
  pinnedAt    DateTime?
  pinnedById  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // E2E Encryption fields
  isEncrypted   Boolean  @default(false)
  encryptionKey String?  // Encrypted symmetric key (wrapped with recipient's public key)
  keyId         String?  // Sender's public key ID used for encryption
  iv            String?  // Initialization vector for AES-GCM

  // Relations
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Message?   @relation("ThreadReplies", fields: [parentId], references: [id])
  replies   Message[]  @relation("ThreadReplies")
  reactions Reaction[]
  attachments Attachment[]

  @@index([workspaceId])
  @@index([channelId, createdAt])
  @@map("messages")
}

model ScheduledMessage {
  id          String   @id @default(cuid())
  content     String
  channelId   String
  userId      String
  scheduledAt DateTime
  status      String   @default("pending") // pending, sent, cancelled
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([scheduledAt, status])
  @@map("scheduled_messages")
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  messageId String
  workspaceId String // Tenant Context
  userId    String
  createdAt DateTime @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([workspaceId])
  @@index([messageId]) // For loading message reactions
  @@map("reactions")
}

model Attachment {
  id           String   @id @default(cuid())
  type         String
  url          String
  name         String
  size         Int?
  mimeType     String?
  messageId    String?  // Optional - standalone uploads don't have a message
  workspaceId  String   // Tenant Context
  uploadedById String   // Track who uploaded the file for ownership verification
  createdAt    DateTime @default(now())

  // Relations
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message    Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("UserUploads", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("attachments")
}

// Direct Messages
model Conversation {
  id          String   @id @default(cuid())
  workspaceId String
  isGroup     Boolean  @default(false)
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  DirectMessage[]

  @@index([workspaceId, updatedAt]) // For listing workspace conversations
  @@map("conversations")
}

model ConversationMember {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])         // For user's conversations
  @@index([conversationId]) // For conversation members
  @@map("conversation_members")
}

model DirectMessage {
  id             String   @id @default(cuid())
  content        String
  conversationId String
  workspaceId    String   // Tenant Context
  userId         String
  isEdited       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // E2E Encryption fields
  isEncrypted   Boolean  @default(false)
  encryptionKey String?  // Encrypted symmetric key (wrapped with recipient's public key)
  keyId         String?  // Sender's public key ID used for encryption
  iv            String?  // Initialization vector for AES-GCM

  // Relations
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([conversationId, createdAt])
  @@map("direct_messages")
}

// ============================================================================
// External Integrations & Webhooks
// ============================================================================

/// API keys for external service authentication.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String    @unique
  keyHash     String    // Hashed version for security
  keyPrefix   String    // First 8 chars for identification
  workspaceId String
  userId      String    // Who created it
  scopes      String    // JSON array: ["messages:read", "messages:write", "channels:read"]
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([keyHash])
  @@map("api_keys")
}

/// Outgoing webhooks - notify external services of events.
model Webhook {
  id          String   @id @default(cuid())
  name        String
  url         String
  secret      String?  // For signing payloads (HMAC)
  workspaceId String
  userId      String   // Who created it
  events      String   // JSON array: ["message.created", "user.joined", "channel.created"]
  isActive    Boolean  @default(true)
  retryCount  Int      @default(3)
  timeoutMs   Int      @default(5000)
  headers     String?  // JSON object for custom headers
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
  @@map("webhooks")
}

/// Incoming webhooks - allow external services to send data.
model IncomingWebhook {
  id          String    @id @default(cuid())
  name        String
  token       String    @unique // Unique token for the webhook URL
  workspaceId String
  channelId   String?   // Target channel for messages
  userId      String    // Who created it
  isActive    Boolean   @default(true)
  allowedIps  String?   // JSON array for IP whitelist
  lastUsedAt  DateTime?
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([token])
  @@map("incoming_webhooks")
}

/// Log of outgoing webhook deliveries.
model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  event        String
  payload      String   // JSON payload
  statusCode   Int?
  response     String?
  success      Boolean  @default(false)
  error        String?
  attemptCount Int      @default(1)
  deliveredAt  DateTime?
  createdAt    DateTime @default(now())

  // Relations
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

/// Pre-built integrations (n8n, Zapier, Slack, etc.).
model Integration {
  id          String   @id @default(cuid())
  type        String   // e.g., "n8n", "zapier", "slack", "discord", "custom"
  name        String
  config      String   // JSON configuration
  workspaceId String
  userId      String   // Who created it
  isActive    Boolean  @default(true)
  status      String   @default("pending") // pending, connected, error
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type])
  @@map("integrations")
}

// Friend requests and friendships
model Friendship {
  id          String   @id @default(cuid())
  requesterId String   // User who sent the request
  addresseeId String   // User who received the request
  status      String   @default("pending") // pending, accepted, declined, blocked
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  requester User @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

// User subscriptions for billing
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  status               String    @default("inactive") // inactive, active, past_due, canceled, trialing
  plan                 String    @default("free") // free, pro, enterprise
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([status])
  @@map("subscriptions")
}

// Push Notifications
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
