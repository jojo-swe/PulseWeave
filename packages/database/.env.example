# =============================================================================
# PulseWeave Database Configuration
# =============================================================================

# SQLite (default - great for development and small teams < 100 users)
DATABASE_URL="file:./dev.db"

# PostgreSQL (recommended for production and scaling 100+ users)
# DATABASE_URL="postgresql://user:password@localhost:5432/pulseweave?schema=public"

# =============================================================================
# Switching Databases
# =============================================================================
# To switch from SQLite to PostgreSQL:
#   1. Update DATABASE_URL above to your PostgreSQL connection string
#   2. Edit packages/database/prisma/schema.prisma:
#      Change: provider = "sqlite"
#      To:     provider = "postgresql"
#   3. Run: pnpm db:generate && pnpm db:push
#
# Note: SQLite works well for small deployments. PostgreSQL is only required
# when you need horizontal scaling, concurrent writes, or 100+ active users.
